    "Thank you to all the open-source contributors and the Swift community for making this project possible." : {
      "comment" : "A section in the \"About\" view that acknowledges the contributions of various open-source projects and the Swift community.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you to all the open-source contributors and the Swift community for making this project possible. Thank you Baptiste Leterrier for your support, you’re the best friend ever. Thank you Claude Code for quickly vide code this project"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci à tous les contributeurs open source et à la communauté Swift d'avoir rendu ce projet possible. Merci Baptiste Leterrier pour ton soutien, t’es le meilleur ami de tous les temps. Merci Claude Code pour le codage rapide de ce projet"
          }
        }
      }
